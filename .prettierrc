{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "htmlWhitespaceSensitivity": "ignore",
  "singleAttributePerLine": true,
  "bracketSameLine": false,
  "proseWrap": "always",

  "plugins": ["prettier-plugin-tailwindcss", "@xeonlink/prettier-plugin-organize-attributes"],
  "attributeGroups": ["^className$", "^(id|name)$", "$DEFAULT", "^aria-"]
}
